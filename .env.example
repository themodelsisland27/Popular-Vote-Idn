# SQL_HOST=/app/cloudsql/project:region:instance
# SQL_USER=ai_studio_app_user
# SQL_PASSWORD=...
# SQL_DB_NAME=cloud_sql_development_database
# SQL_ADMIN_USER=ai_studio_admin
# SQL_ADMIN_PASSWORD=...

# B. Di Lingkungan Vercel / Eksternal Cloud Database (Neon, Supabase, Cloud SQL Public IP):
# Masukkan connection string PostgreSQL lengkap:
